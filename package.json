{
  "name": "techbrotherz",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for TechBrotherz, a walk-in cell phone and computer repair shop in Calgary, Alberta.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "schema:extract": "sanity schema extract --path=./sanity/extract.json",
    "typegen": "pnpm schema:extract && sanity typegen generate",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:reset": "tsx --env-file=.env.local scripts/seed.ts --reset",
    "seed:verify": "tsx --env-file=.env.local scripts/verify-seed.ts",
    "sanity:validate": "sanity documents validate --yes --level error --format pretty",
    "prove:validation": "tsx --env-file=.env.local scripts/prove-validation.ts",
    "prove:action": "tsx --env-file=.env.local scripts/prove-studio-action.ts",
    "prove:revalidate": "tsx --env-file=.env.local scripts/prove-revalidate.ts",
    "verify": "tsx scripts/verify.ts",
    "audit:pages": "tsx scripts/audit-pages.ts",
    "audit:similarity": "tsx scripts/content-similarity.ts",
    "test:contrast": "tsx scripts/test-contrast.ts",
    "audit:browser": "tsx scripts/audit-browser.ts",
    "audit:lighthouse": "tsx scripts/audit-lighthouse.ts",
    "audit:keyboard": "tsx scripts/test-keyboard.ts",
    "audit:dom": "tsx scripts/measure-dom.ts",
    "test:timezone": "tsx scripts/test-timezone.ts",
    "sanity:deploy": "sanity deploy",
    "build:clean": "node -e \"require('fs').rmSync('.next/cache/fetch-cache',{recursive:true,force:true})\" && next build",
    "test:faq": "tsx scripts/test-faq-scoping.ts",
    "test:determinism": "tsx --env-file=.env.local scripts/test-build-determinism.ts",
    "audit:words": "tsx scripts/word-counts.ts",
    "audit:schema": "tsx scripts/validate-schema.ts",
    "test:noindex": "tsx scripts/test-staging-noindex.ts",
    "audit:local-facts": "tsx scripts/audit-local-facts.ts",
    "images:process": "tsx scripts/process-images.ts",
    "images:manifest": "tsx scripts/build-image-manifest.ts",
    "audit:weight": "tsx scripts/measure-weight.ts",
    "test:placeholders": "tsx scripts/test-no-placeholders.ts",
    "test:write-guard": "tsx scripts/test-write-guard.ts",
    "census": "tsx --env-file=.env.local scripts/census-production.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@portabletext/react": "^7.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^7.25.0",
    "@sanity/icons": "^3.8.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/ui": "^2.16.26",
    "@sanity/vision": "^3.99.0",
    "@sanity/webhook": "^4.0.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "^15.5.22",
    "next-sanity": "^9.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "sanity": "^3.99.0",
    "styled-components": "^6.4.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
