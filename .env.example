# Copy this file to .env.local and fill in the values.
# Never commit .env.local. See CLAUDE.md Section 11.
#
# The site is static. All content is compiled in from content/data/ and
# lib/content/, so a build needs no credentials and cannot fail by returning an
# empty dataset. Nothing below is required: every variable is an optional
# integration or a local override.

# --- Nothing is required ----------------------------------------------------

# Canonical origin. No trailing slash. Drives metadata, canonicals, sitemap and
# JSON-LD, and the middleware that keeps non-canonical hosts out of the index.
#
# OPTIONAL, and only an override. The canonical origin is a constant in
# lib/site-url.ts, because the site has exactly one and always did. Set this
# only to point a build somewhere else, which is what the local audits do.
# Leave it unset in production and on any hosting project.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Contact form (optional, degrades gracefully if unset) ------------------

# Brevo transactional email, for the contact form. All four optional: without
# them the form still renders and submits, and the visitor is pointed at the
# phone number.
# The API key from the Brevo dashboard (SMTP & API section). Server-side only.
BREVO_API_KEY=
# Where enquiries are delivered. The store's Gmail; needs no verification.
CONTACT_TO_EMAIL=
# The sender, on the domain authenticated in Brevo (DNS TXT records).
# Never a Gmail address: it fails alignment and lands in spam. Does not need
# to be a real mailbox; the reply-to carries the conversation.
BREVO_FROM_EMAIL=
# The sender display name shown in the inbox.
BREVO_FROM_NAME=TechBrotherz

# --- Cloudflare Turnstile (spam protection on the contact form) -------------

# Turnstile is the third defence on the contact form, behind the honeypot and
# the rate limit and in front of zod. See lib/turnstile.ts.
#
# The values below are Cloudflare's own published TEST keys, not secrets. The
# site key always renders a widget that passes; the secret key always verifies.
# They keep local development and `pnpm verify` working out of the box. Replace
# both with the real pair from the Cloudflare dashboard on the deployment.
#
# The secret is required in production: a production server with it unset
# refuses submissions at request time rather than quietly waving bots through.
# A BUILD still needs nothing, in either case.

# Public. Ships in the browser bundle, and is meant to.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Server-side only. Never expose this one.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Uplift AI blog CMS (the blog, and only the blog) -----------------------

# The blog at /blog is the one part of this site whose content is not compiled
# in from content/data/. The client writes and publishes articles in Uplift and
# the site reads them through the public blog API, revalidating hourly, so a
# new article appears without a redeploy.
#
# OPTIONAL, like everything else here. Without the token /blog renders an
# honest empty state, the build logs one warning and the rest of the site is
# untouched. Set it in .env.local locally and on the hosting project, or the
# blog is empty in production.
#
# Server-side only. Never NEXT_PUBLIC_: it would ship in the browser bundle,
# and this token reads the client's whole CMS.
UPLIFT_API_TOKEN=

# Override only. Defaults to https://api.upliftai.co/api/public/v1.
UPLIFT_API_URL=

# Override only. Comma-separated extra hostnames that next/image may optimise
# blog images from. Defaults to Uplift's CDN, res.cloudinary.com. An image from
# a host not on the list still renders, unoptimised, rather than failing the
# build. See lib/uplift/image-hosts.ts.
UPLIFT_IMAGE_HOSTS=

# --- Analytics (optional, skipped if unset) ---------------------------------

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
