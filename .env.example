# Copy this file to .env.local and fill in the values.
# Never commit .env.local. See CLAUDE.md Section 11.

# --- Required ---------------------------------------------------------------

# Canonical origin. No trailing slash. Drives metadata, canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (required from Phase 2) -----------------------------------------

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-side read token for draft previews. Optional.
SANITY_API_READ_TOKEN=

# Used by `pnpm seed` only. Never exposed to the browser.
SANITY_API_WRITE_TOKEN=

# Shared secret for the /api/revalidate webhook. Set the same value in the
# Sanity webhook settings at sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# Shared secret for the Studio preview pane handshake at /api/draft-mode/enable.
# NEXT_PUBLIC because the Studio bundle supplies it, which means it is visible
# to anyone who can load /studio. It guards drafts against casual access, not
# against a determined visitor. See app/api/draft-mode/enable/route.ts.
NEXT_PUBLIC_SANITY_PREVIEW_SECRET=

# --- Contact form (optional, degrades gracefully if unset) ------------------

RESEND_API_KEY=
CONTACT_TO_EMAIL=

# --- Analytics (optional, skipped if unset) ---------------------------------

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
